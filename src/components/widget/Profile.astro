---
import { Icon } from "astro-icon/components";
import { profileConfig } from "../../config";
import { i18n, I18nKey } from "../../i18n/translation";
import { url } from "../../utils/url-utils";
import ImageWrapper from "../misc/ImageWrapper.astro";
import TypewriterText from "../TypewriterText.astro";
import {
	getCategoryList,
	getSortedPosts,
	getTagList,
} from "../../utils/content-utils";

// 站点内容统计（设计借鉴旧博客 card-info-data 的三宫格）
const postCount = (await getSortedPosts()).length;
const tagList = await getTagList();
const categoryList = await getCategoryList();
const topTag = [...tagList].sort((a, b) => b.count - a.count)[0];
const topCategory = [...categoryList].sort((a, b) => b.count - a.count)[0];
const tagHref = topTag
	? url(`/archive/?tag=${encodeURIComponent(topTag.name.trim())}`)
	: url("/archive/");
const categoryHref = topCategory
	? url(`/archive/?category=${encodeURIComponent(topCategory.name.trim())}`)
	: url("/archive/");
---

<div class="card-base p-3">
    <a aria-label="Go to About Page" href={url('/about/')}
       class="group block relative mx-auto mt-1 lg:mx-0 lg:mt-0 mb-3
       max-w-48 lg:max-w-none overflow-hidden rounded-xl active:scale-95">
        <div class="absolute transition pointer-events-none group-hover:bg-black/30 group-active:bg-black/50
        w-full h-full z-50 flex items-center justify-center">
            <Icon name="fa7-regular:address-card"
                  class="transition opacity-0 scale-90 group-hover:scale-100 group-hover:opacity-100 text-white text-5xl">
            </Icon>
        </div>
        <ImageWrapper src={profileConfig.avatar || ""} alt="Profile Image of the Author" class="mx-auto lg:w-full h-full lg:mt-0 "></ImageWrapper>
    </a>
    <div class="px-2">
        <div class="font-bold text-xl text-center mb-1 dark:text-neutral-50 transition">{profileConfig.name}</div>
        <div class="h-1 w-5 bg-(--primary) mx-auto rounded-full mb-2 transition"></div>
        
        <div class="text-center text-neutral-400 mb-2.5 transition">
            {profileConfig.typewriter?.enable ? (
                <TypewriterText 
                    text={profileConfig.bio || ""}
                    speed={profileConfig.typewriter.speed}
                    class="inline-block"
                />
            ) : (
                profileConfig.bio
            )}
        </div>

        <!-- 内容统计三宫格：文章 / 标签 / 分类 -->
        <div class="profile-stats">
            <a href={url('/archive/')} class="profile-stat" aria-label={`共 ${postCount} 篇文章`}>
                <span class="profile-stat-num">{postCount}</span>
                <span class="profile-stat-label">文章</span>
            </a>
            <a href={tagHref} class="profile-stat" aria-label={`共 ${tagList.length} 个标签`}>
                <span class="profile-stat-num">{tagList.length}</span>
                <span class="profile-stat-label">标签</span>
            </a>
            <a href={categoryHref} class="profile-stat" aria-label={`共 ${categoryList.length} 个分类`}>
                <span class="profile-stat-num">{categoryList.length}</span>
                <span class="profile-stat-label">分类</span>
            </a>
        </div>

        <div class="flex flex-wrap gap-2 justify-center mb-1">
            {profileConfig.links.length > 1 && profileConfig.links.map(item =>
                <a rel="me" aria-label={item.name} href={item.url} target="_blank"
                   class="btn-regular rounded-lg h-10 w-10 active:scale-90 group/social transition-all duration-300 hover:-translate-y-0.5 hover:text-(--primary) dark:hover:text-(--primary)">
                    <Icon name={item.icon} class="text-[1.5rem] transition-transform duration-300 group-hover/social:scale-110"></Icon>
                </a>
            )}
            {profileConfig.links.length == 1 && 
                <a rel="me" aria-label={profileConfig.links[0].name} href={profileConfig.links[0].url} target="_blank"
                   class="btn-regular rounded-lg h-10 gap-2 px-3 font-bold active:scale-95">
                    <Icon name={profileConfig.links[0].icon} class="text-[1.5rem]"></Icon>
                    {profileConfig.links[0].name}
                </a>
            }
        </div>
        
        <div class="umami-stats-container hidden">
            <hr class="my-2 border-t border-dashed border-black/10 dark:border-white/10 transition-colors duration-150" />
            <div class="text-sm text-50 mt-2 text-center transition-colors duration-150">
                <Icon name="fa7-solid:eye" class="inline-block mr-1 text-50 text-sm align-middle" />
                <span class="site-stats-display">{i18n(I18nKey.profileStatsLoading)}</span>
            </div>
        </div>
    </div>
</div>

<script is:inline define:vars={{
    profileStatsPageViews: i18n(I18nKey.profileStatsPageViews),
    profileStatsVisits: i18n(I18nKey.profileStatsVisits),
    profileStatsUnavailable: i18n(I18nKey.profileStatsUnavailable)
}}>
    function generateStatsText(pageViews, visits) {
        return `${profileStatsPageViews} ${pageViews} · ${profileStatsVisits} ${visits}`;
    }

    async function fetchSiteStats(isRetry = false) {
        const container = document.querySelector('.umami-stats-container');
        
        // oddmisc 未加载则等待重试
        if (!window.oddmisc) {
            if (!isRetry) {
                setTimeout(() => fetchSiteStats(true), 500);
            } else {
                container?.classList.add('hidden');
            }
            return;
        }

        try {
            const stats = await window.oddmisc.getSiteStats();
            const pageViews = stats.pageviews || 0;
            const visits = stats.visits || 0;

            // 数据为 0 时隐藏
            if (pageViews === 0 && visits === 0) {
                container?.classList.add('hidden');
                return;
            }

            container?.classList.remove('hidden');
            document.querySelectorAll('.site-stats-display').forEach(el => {
                el.textContent = generateStatsText(pageViews, visits);
            });
        } catch (error) {
            console.error('Error fetching site stats:', error);
            container?.classList.add('hidden');
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => fetchSiteStats());
    } else {
        fetchSiteStats();
    }
</script>
<style>
    /* 内容统计三宫格（借鉴旧博客 card-info-data） */
    .profile-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.25rem;
        margin: 0.5rem 0 0.75rem;
        padding: 0.5rem 0;
        border-top: 1px dashed var(--line-divider);
        border-bottom: 1px dashed var(--line-divider);
    }

    .profile-stat {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.1rem;
        padding: 0.25rem 0;
        border-radius: 0.75rem;
        text-decoration: none;
        transition: background-color 0.25s ease;
    }

    .profile-stat:hover {
        background: color-mix(in oklab, var(--primary) 10%, transparent);
    }

    .profile-stat-num {
        font-size: 1.15rem;
        font-weight: 800;
        line-height: 1.2;
        color: var(--primary);
    }

    .profile-stat-label {
        font-size: 0.72rem;
        color: var(--text-color-50, #888);
    }
</style>

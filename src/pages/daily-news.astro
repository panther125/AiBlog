---
import { siteConfig } from "../config";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import MainGridLayout from "../layouts/MainGridLayout.astro";

// 检查页面是否启用（可选）
// if (!siteConfig.featurePages.dailyNews) {
// 	return Astro.redirect("/404/");
// }

// 获取今天的日期
const today = new Date().toISOString().split('T')[0];

// 获取60秒新闻数据
let newsData: {
	date: string;
	news: string[];
	tip: string;
	cover: string;
	image: string;
	day_of_week: string;
	lunar_date: string;
} | null = null;
let error: string | null = null;

try {
	const response = await fetch(`https://60s.viki.moe/v2/60s?date=${today}&encoding=json`, {
		method: 'GET',
		headers: {
			'Accept': 'application/json',
		},
	});
	
	if (!response.ok) {
		throw new Error(`HTTP error! status: ${response.status}`);
	}
	
	const result = await response.json();
	if (result.code === 200 && result.data) {
		newsData = result.data;
	} else {
		error = result.message || '获取数据失败';
	}
} catch (e) {
	error = '获取资讯失败，请稍后重试';
	console.error('Failed to fetch 60s news:', e);
}
---

<MainGridLayout 
	title="每天60秒读懂世界" 
	description="每天60秒，了解全球热点资讯"
>
	<div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
		<div class="card-base z-10 px-9 py-6 relative w-full">
			<!-- 页面标题 -->
			<header class="mb-8">
				<div class="flex items-center gap-3 mb-3">
					<div class="w-12 h-12 rounded-xl bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center text-white text-2xl">
						⏰
					</div>
					<div>
						<h1 class="text-3xl font-bold text-90">
							每天60秒读懂世界
						</h1>
						<p class="text-60 text-sm mt-1">
							数据来源: 60s API
						</p>
					</div>
				</div>
			</header>

			{error && (
				<div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg p-4 mb-6">
					<div class="flex items-center gap-2 text-red-600 dark:text-red-400">
						<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
							<path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
						</svg>
						<span>{error}</span>
					</div>
				</div>
			)}

			{newsData && (
				<div class="space-y-6">
					<!-- 日期信息卡片 -->
					<div class="flex flex-wrap items-center gap-4 text-sm text-50 mb-6">
						<span class="flex items-center gap-1.5 bg-(--card-bg) px-3 py-1.5 rounded-lg border border-(--line-divider)">
							<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
								<path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd" />
							</svg>
							{newsData.date}
						</span>
						<span class="flex items-center gap-1.5 bg-(--card-bg) px-3 py-1.5 rounded-lg border border-(--line-divider)">
							<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
								<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
							</svg>
							{newsData.day_of_week}
						</span>
						<span class="flex items-center gap-1.5 bg-(--card-bg) px-3 py-1.5 rounded-lg border border-(--line-divider)">
							<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
								<path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z" />
							</svg>
							{newsData.lunar_date}
						</span>
					</div>

					<!-- 封面图片 -->
					{newsData.image && (
						<div class="rounded-xl overflow-hidden mb-6 shadow-lg">
							<img 
								src={newsData.image} 
								alt="每日新闻封面"
								class="w-full h-auto object-cover"
								loading="lazy"
							/>
						</div>
					)}

					<!-- 新闻列表 -->
					<div class="bg-(--card-bg) rounded-xl border border-(--line-divider) overflow-hidden">
						<div class="px-6 py-4 border-b border-(--line-divider) bg-gradient-to-r from-blue-500/10 to-purple-500/10">
							<h2 class="font-bold text-lg text-90 flex items-center gap-2">
								<svg class="w-5 h-5 text-blue-500" fill="currentColor" viewBox="0 0 20 20">
									<path d="M10 2a6 6 0 00-6 6v3.586l-.707.707A1 1 0 004 14h12a1 1 0 00.707-1.707L16 11.586V8a6 6 0 00-6-6zM10 18a3 3 0 01-3-3h6a3 3 0 01-3 3z" />
								</svg>
								今日热点
							</h2>
						</div>
						<div class="divide-y divide-(--line-divider)">
							{newsData.news.map((item, index) => (
								<div class="px-6 py-4 hover:bg-(--hover-bg) transition-colors">
									<div class="flex gap-4">
										<span class="flex-shrink-0 w-7 h-7 rounded-full bg-gradient-to-br from-blue-500 to-purple-600 text-white text-sm font-bold flex items-center justify-center">
											{index + 1}
										</span>
										<p class="text-90 leading-relaxed pt-0.5">{item}</p>
									</div>
								</div>
							))}
						</div>
					</div>

					<!-- 每日一句 -->
					{newsData.tip && (
						<div class="mt-6 p-6 rounded-xl bg-gradient-to-r from-amber-50 to-orange-50 dark:from-amber-900/20 dark:to-orange-900/20 border border-amber-200 dark:border-amber-800">
							<div class="flex items-start gap-3">
								<span class="text-2xl">💡</span>
								<div>
									<p class="text-amber-800 dark:text-amber-200 font-medium italic">
										"{newsData.tip}"
									</p>
								</div>
							</div>
						</div>
					)}
				</div>
			)}

			<!-- 刷新按钮 -->
			<div class="mt-8 flex justify-center">
				<button 
					onclick="window.location.reload()"
					class="btn-regular h-10 px-6 rounded-lg flex items-center gap-2"
				>
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
					</svg>
					刷新数据
				</button>
			</div>
		</div>
	</div>
</MainGridLayout>

<style>
	/* 添加一些自定义样式 */
</style>

---
import { Icon } from "astro-icon/components";
import ImageWrapper from "../components/misc/ImageWrapper.astro";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { profileConfig, siteConfig } from "../config";
import {
	getAllTechStack,
	getFeaturedProjects,
	getProjectStats,
	projectsData,
} from "../data/projects";
import {
	getCategoryList,
	getSortedPosts,
	getTagList,
} from "../utils/content-utils";
import { getPostUrl, url } from "../utils/url-utils";

const DAY_MS = 86400000;
const WEEK_COUNT = 53; // GitHub 贡献图默认展示最近一年

const posts = await getSortedPosts();
const categories = await getCategoryList();
const tags = await getTagList();
const featuredProjects = getFeaturedProjects();
const projectStats = getProjectStats();
const techStack = getAllTechStack();
const inProgressProjects = projectsData.filter(
	(p) => p.status === "in-progress",
);

function pad(value: number): string {
	return value < 10 ? `0${value}` : `${value}`;
}

function dateKey(date: Date): string {
	return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}`;
}

function formatDate(date: Date): string {
	return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}`;
}

// 按发布日聚合，供写作活跃热力图使用
const postsPerDay = new Map<string, number>();
for (const post of posts) {
	const key = dateKey(new Date(post.data.published));
	postsPerDay.set(key, (postsPerDay.get(key) ?? 0) + 1);
}

const maxPerDay = Math.max(1, ...postsPerDay.values());

function levelOf(count: number): number {
	if (count <= 0) return 0;
	return Math.min(4, Math.ceil((count / maxPerDay) * 4));
}

// 起点回退到上一个周日，保证每列是完整的一周
const gridEnd = new Date();
gridEnd.setHours(0, 0, 0, 0);
const gridStart = new Date(gridEnd.getTime() - (WEEK_COUNT * 7 - 1) * DAY_MS);
gridStart.setHours(0, 0, 0, 0);
gridStart.setDate(gridStart.getDate() - gridStart.getDay());

type ActivityCell = {
	key: string;
	label: string;
	count: number;
	level: number;
};

const cells: ActivityCell[] = [];
for (
	const cursor = new Date(gridStart);
	cursor <= gridEnd;
	cursor.setDate(cursor.getDate() + 1)
) {
	const count = postsPerDay.get(dateKey(cursor)) ?? 0;
	cells.push({
		key: dateKey(cursor),
		label: `${cursor.getMonth() + 1}月${cursor.getDate()}日`,
		count,
		level: levelOf(count),
	});
}

const activityWeeks: { month: string; days: ActivityCell[] }[] = [];
for (let i = 0; i < cells.length; i += 7) {
	const days = cells.slice(i, i + 7);
	// 每个月的 1 号只会落在某一周里，用它作为该列的月份标签
	const monthStart = days.find((day) => day.key.endsWith("-01"));
	activityWeeks.push({
		month: monthStart ? `${Number(monthStart.key.slice(5, 7))}月` : "",
		days,
	});
}

const yearlyPostCount = cells.reduce((sum, cell) => sum + cell.count, 0);
const activeDayCount = cells.filter((cell) => cell.count > 0).length;
const runningDays = Math.max(
	0,
	Math.floor(
		(gridEnd.getTime() - new Date(`${siteConfig.siteStartDate}T00:00:00`).getTime()) /
			DAY_MS,
	),
);

const topTags = [...tags].sort((a, b) => b.count - a.count).slice(0, 8);
const recentPosts = [...posts]
	.sort(
		(a, b) =>
			b.data.published.getTime() - a.data.published.getTime(),
	)
	.slice(0, 5);

const statusText: Record<string, string> = {
	completed: "已完成",
	"in-progress": "进行中",
	planned: "计划中",
};

const highlights = [
	{ icon: "material-symbols:article", label: "文章", value: posts.length },
	{ icon: "material-symbols:folder", label: "分类", value: categories.length },
	{ icon: "material-symbols:label", label: "标签", value: tags.length },
	{
		icon: "material-symbols:code",
		label: "项目",
		value: projectStats.total,
	},
	{
		icon: "material-symbols:calendar-month",
		label: "建站",
		value: runningDays,
		suffix: "天",
	},
];

const title = "关于我";
const description = profileConfig.bio;
---

<MainGridLayout title={title} description={description}>
	<!-- 引入右侧边栏布局管理器 -->
	<script>
		import("../scripts/right-sidebar-layout.js");
	</script>

	<div class="flex w-full rounded-(--radius-large) overflow-hidden relative">
		<div class="card-base z-10 px-9 py-6 relative w-full">
			<!-- 页面标题 -->
			<div class="flex flex-col items-start justify-center mb-6">
				<h1 class="text-4xl font-bold text-90 mb-2 relative
					before:w-1 before:h-8 before:rounded-md before:bg-(--primary)
					before:absolute before:top-1/2 before:-translate-y-1/2 before:-left-4">
					{title}
				</h1>
				<p class="text-lg text-60">{description}</p>
			</div>

			<div class="grid grid-cols-1 lg:grid-cols-[17rem_1fr] gap-6">
				<!-- 左列：身份卡，对应 GitHub 头像栏 -->
				<div class="gh-profile-card">
					<div class="gh-avatar mx-auto lg:mx-0">
						<ImageWrapper
							src={profileConfig.avatar || ""}
							alt={`${profileConfig.name} 的头像`}
							loading="eager"
							class="w-full h-full"
						/>
					</div>
					<div class="mt-3">
						<h2 class="text-xl font-bold text-90 leading-tight">
							{profileConfig.name}
						</h2>
						<p class="text-60 text-sm mt-1 leading-relaxed">
							{profileConfig.bio}
						</p>
					</div>

					<div class="gh-meta-row text-50">
						<Icon
							name="material-symbols:calendar-today"
							class="text-base"
						/>
						<span>建站于 {siteConfig.siteStartDate}</span>
					</div>

					<div class="flex flex-wrap gap-2 mt-3">
						{
							profileConfig.links.map((link) => (
								<a
									href={link.url}
									target="_blank"
									rel="noopener noreferrer"
									class="gh-profile-btn text-70"
									aria-label={link.name}
								>
									<Icon name={link.icon} class="text-base" />
									<span>{link.name}</span>
								</a>
							))
						}
					</div>

					<div class="gh-divider"></div>

					<h3 class="gh-card-title text-90">
						<Icon name="material-symbols:insights" class="text-lg" />
						<span>站点数据</span>
					</h3>
					<ul class="gh-highlight-list">
						{
							highlights.map((item) => (
								<li>
									<Icon
										name={item.icon}
										class="text-lg text-(--primary) shrink-0"
									/>
									<span class="text-60">{item.label}</span>
									<span class="ml-auto font-bold text-90">
										{item.value}
										{item.suffix ?? ""}
									</span>
								</li>
							))
						}
					</ul>
				</div>

				<!-- 右列：README 风格内容区 -->
				<div class="min-w-0 flex flex-col gap-6">
					<!-- 关于我 -->
					<section class="gh-section">
						<h3 class="gh-card-title text-90">
							<Icon name="material-symbols:person-book" class="text-lg" />
							<span>关于我</span>
						</h3>
						<p class="text-75 leading-relaxed">
							我是 {profileConfig.name}，主要写 Java 后端（Spring Boot
							相关的数据平台、在线判题、聚合搜索这类项目），也会用 Vue 3 +
							TypeScript 写前端，最近在推进 LLM
							方向的分析工具。这个博客用来记录技术学习与日常思考，写作方向集中在下面这些标签上。
						</p>
						<div class="flex flex-wrap gap-2 mt-3">
							{
								topTags.map((tag) => (
									<a
										href={url(`/archive/?tag=${encodeURIComponent(tag.name)}`)}
										class="gh-chip text-70"
									>
										{tag.name}
										<span class="gh-chip-count text-50">{tag.count}</span>
									</a>
								))
							}
						</div>
						{
							inProgressProjects.length > 0 && (
								<div class="mt-4">
									<div class="text-60 text-sm mb-2">正在做的事</div>
									<ul class="gh-doing-list">
										{inProgressProjects.map((project) => (
											<li>
												<Icon
													name="material-symbols:pending"
													class="text-base text-(--primary) shrink-0"
												/>
												<span class="text-75">
													{project.title}
												</span>
												{project.sourceCode && (
													<a
														href={project.sourceCode}
														target="_blank"
														rel="noopener noreferrer"
														class="ml-auto text-50 hover:text-(--primary)"
														aria-label={`${project.title} 源码`}
													>
														<Icon
															name="fa7-brands:github"
															class="text-base"
														/>
													</a>
												)}
											</li>
										))}
									</ul>
								</div>
							)
						}
					</section>

					<!-- 写作活跃热力图 -->
					<section class="gh-section">
						<div class="flex flex-wrap items-center justify-between gap-2">
							<h3 class="gh-card-title text-90">
								<Icon
									name="material-symbols:groups"
									class="text-lg"
								/>
								<span>最近一年写作活跃</span>
							</h3>
							<span class="text-50 text-sm">
								共 {yearlyPostCount} 篇 · {activeDayCount} 天有更新
							</span>
						</div>

						<div class="gh-heat-scroll">
							<div class="gh-month-row">
								{
									activityWeeks.map((week) => (
										<span class="gh-month text-50">{week.month}</span>
									))
								}
							</div>
							<div class="gh-heat">
								{
									activityWeeks.map((week) => (
										<div class="gh-week">
											{week.days.map((day) => (
												<div
													class:list={[
														"gh-cell",
														`lv${day.level}`,
													]}
													title={
														day.count > 0
															? `${day.key} 发布 ${day.count} 篇`
															: `${day.key} 无更新`
													}
												></div>
											))}
										</div>
									))
								}
							</div>
							<div class="flex items-center justify-end gap-1.5 mt-2 text-50 text-xs">
								<span>少</span>
								{
									[0, 1, 2, 3, 4].map((level) => (
										<span
											class:list={["gh-cell", `lv${level}`]}
										></span>
									))
								}
								<span>多</span>
							</div>
						</div>
					</section>

					<!-- 技术栈 -->
					<section class="gh-section">
						<h3 class="gh-card-title text-90">
							<Icon name="material-symbols:psychology" class="text-lg" />
							<span>技术栈</span>
						</h3>
						<div class="flex flex-wrap gap-2">
							{
								techStack.map((tech) => (
									<span class="gh-chip gh-chip-tech text-70">{tech}</span>
								))
							}
						</div>
					</section>

					<!-- 精选项目，对应 GitHub 的仓库卡片 -->
					<section class="gh-section">
						<h3 class="gh-card-title text-90">
							<Icon name="material-symbols:work" class="text-lg" />
							<span>精选项目</span>
							<a href={url("/projects/")} class="gh-section-link">
								全部项目
							</a>
						</h3>
						<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
							{
								featuredProjects.map((project) => (
									<article class="gh-repo">
										<div class="flex items-start gap-2">
											<Icon
												name={
													project.status ===
													"in-progress"
														? "material-symbols:folder-open"
														: "material-symbols:folder"
												}
												class="text-lg text-60 shrink-0 mt-0.5"
											/>
											<h4 class="font-semibold text-90 leading-snug min-w-0">
												{project.sourceCode ? (
													<a
														href={project.sourceCode}
														target="_blank"
														rel="noopener noreferrer"
														class="hover:text-(--primary) transition-colors"
													>
														{project.title}
													</a>
												) : (
													<span>{project.title}</span>
												)}
											</h4>
											<span class="gh-status text-50 ml-auto shrink-0">
												{statusText[project.status] ??
													project.status}
											</span>
										</div>
										<p class="text-60 text-sm leading-relaxed mt-2 line-clamp-2">
											{project.description}
										</p>
										<div class="flex flex-wrap items-center gap-2 mt-3">
											{project.techStack.map((tech) => (
												<span class="gh-chip gh-chip-sm text-70">
													{tech}
												</span>
											))}
											{project.visitUrl && (
												<a
													href={project.visitUrl}
													target="_blank"
													rel="noopener noreferrer"
													class="ml-auto gh-section-link"
												>
													在线预览
												</a>
											)}
										</div>
									</article>
								))
							}
						</div>
					</section>

					<!-- 最近文章 -->
					<section class="gh-section">
						<h3 class="gh-card-title text-90">
							<Icon
								name="material-symbols:article"
								class="text-lg"
							/>
							<span>最近文章</span>
							<a href={url("/archive/")} class="gh-section-link">
								归档
							</a>
						</h3>
						<ul class="gh-post-list">
							{
								recentPosts.map((post) => (
									<li>
										<span class="gh-post-date text-50">
											{formatDate(new Date(post.data.published))}
										</span>
										<a
											href={getPostUrl(post)}
											class="text-75 hover:text-(--primary) transition-colors min-w-0 truncate"
										>
											{post.data.title}
										</a>
										{post.data.category && (
											<a
												href={url(
													`/archive/?category=${encodeURIComponent(post.data.category)}`,
												)}
												class="gh-chip gh-chip-sm text-70 ml-auto shrink-0"
											>
												{post.data.category}
											</a>
										)}
									</li>
								))
							}
						</ul>
					</section>
				</div>
			</div>
		</div>
	</div>
</MainGridLayout>

<style>
	.gh-profile-card,
	.gh-section,
	.gh-repo {
		border: 1px solid var(--line-divider);
		border-radius: var(--radius-large);
	}

	.gh-profile-card,
	.gh-section {
		background: var(--card-bg);
	}

	.gh-profile-card {
		padding: 1rem;
		align-self: start;
	}

	.gh-section {
		padding: 1.25rem;
	}

	.gh-avatar {
		width: 8rem;
		height: 8rem;
		overflow: hidden;
		border: 1px solid var(--line-divider);
		border-radius: var(--radius-large);
	}

	@media (min-width: 1024px) {
		.gh-avatar {
			width: 100%;
			height: auto;
			aspect-ratio: 1 / 1;
		}
	}

	.gh-meta-row {
		display: flex;
		align-items: center;
		gap: 0.375rem;
		margin-top: 0.75rem;
		font-size: 0.875rem;
	}

	.gh-profile-btn {
		display: flex;
		align-items: center;
		gap: 0.375rem;
		padding: 0.375rem 0.75rem;
		border: 1px solid var(--line-divider);
		border-radius: 0.5rem;
		font-size: 0.875rem;
		transition: color 0.15s ease, border-color 0.15s ease;
	}

	.gh-divider {
		height: 1px;
		background: var(--line-divider);
		margin: 1rem 0;
	}

	.gh-card-title {
		display: flex;
		align-items: center;
		gap: 0.375rem;
		font-weight: 700;
		margin-bottom: 0.75rem;
	}

	.gh-section-link {
		margin-left: auto;
		font-size: 0.875rem;
		font-weight: 500;
		color: var(--primary);
	}

	.gh-section-link:hover {
		text-decoration: underline;
	}

	.gh-highlight-list li,
	.gh-doing-list li {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.375rem 0;
		font-size: 0.875rem;
	}

	.gh-chip {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		padding: 0.25rem 0.625rem;
		border: 1px solid var(--line-divider);
		border-radius: 9999px;
		font-size: 0.875rem;
		transition: color 0.15s ease, border-color 0.15s ease;
	}

	.gh-chip:hover,
	.gh-profile-btn:hover,
	.gh-repo:hover {
		color: var(--primary);
		border-color: var(--primary);
	}

	.gh-chip-sm {
		padding: 0.125rem 0.5rem;
		font-size: 0.75rem;
	}

	.gh-chip-count {
		font-size: 0.75rem;
	}

	.gh-chip-tech {
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.75rem;
	}

	.gh-repo {
		padding: 1rem;
		display: flex;
		flex-direction: column;
		transition: border-color 0.15s ease;
	}

	.gh-status {
		font-size: 0.75rem;
		padding: 0.125rem 0.5rem;
		border: 1px solid var(--line-divider);
		border-radius: 9999px;
	}

	.gh-post-list li {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.5rem 0;
		border-bottom: 1px solid var(--line-divider);
		font-size: 0.875rem;
	}

	.gh-post-list li:last-child {
		border-bottom: none;
	}

	.gh-post-date {
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.75rem;
		width: 6rem;
		flex-shrink: 0;
	}

	.gh-heat-scroll {
		overflow-x: auto;
		padding-bottom: 0.25rem;
	}

	.gh-month-row {
		display: flex;
		gap: 3px;
		margin-bottom: 4px;
	}

	.gh-month {
		width: 11px;
		flex-shrink: 0;
		white-space: nowrap;
		font-size: 10px;
		line-height: 1.2;
	}

	.gh-heat {
		display: flex;
		gap: 3px;
		width: max-content;
	}

	.gh-week {
		display: flex;
		flex-direction: column;
		gap: 3px;
	}

	.gh-cell {
		width: 11px;
		height: 11px;
		border-radius: 2px;
		flex-shrink: 0;
		background: rgb(128 128 128 / 0.18);
	}

	.gh-cell.lv1 {
		background: var(--primary);
		opacity: 0.3;
	}

	.gh-cell.lv2 {
		background: var(--primary);
		opacity: 0.5;
	}

	.gh-cell.lv3 {
		background: var(--primary);
		opacity: 0.75;
	}

	.gh-cell.lv4 {
		background: var(--primary);
		opacity: 1;
	}
</style>
